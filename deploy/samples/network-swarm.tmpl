{{- if .Container -}}
docker network create --config-only --subnet {{.Network}} --ip-range {{.Range}} \
  --gateway {{.Gateway}}{{if .Network6}} --ipv6 --subnet {{.Network6}} --ip-range {{.Range6}} \
  --gateway {{.Gateway6}}{{end}} {{.NetworkName}}-config
{{- else -}}
docker network create --config-only --subnet {{.Network}} --ip-range {{.Range}} --gateway {{.Gateway}} \
{{- if .Network6}}
  --ipv6 --subnet {{.Network6}} --ip-range {{.Range6}} --gateway {{.Gateway6}} \
  -o com.docker.network.bridge.gateway_mode_ipv6=nat-unprotected \
{{- end}}
  -o com.docker.network.bridge.name={{.BridgeName}} -o com.docker.network.bridge.inhibit_ipv4=true \
  -o com.docker.network.bridge.enable_ip_masquerade=false \
  -o com.docker.network.bridge.gateway_mode_ipv4=nat-unprotected {{.NetworkName}}-config
{{- end}}
docker network create -d bridge --scope swarm --attachable --config-from {{.NetworkName}}-config {{.NetworkName}}
