services:
  meshctl:
    image: {{.Image}}
    environment:
      MESHCTL_URL: {{.URL}}
      MESHCTL_NAME: {{.Name}}
      MESHCTL_TOKEN: ${MESHCTL_TOKEN:-}
    user: "0:0"
    privileged: false
    network_mode: host
    cap_drop: [ALL]
    cap_add: [NET_ADMIN, NET_BIND_SERVICE]
    security_opt: ["no-new-privileges=true"]
    read_only: true
    tmpfs: ["/tmp:size=16m,mode=1777"]
    devices: ["/dev/net/tun:/dev/net/tun"]
    volumes: ["{{.Data}}:/data", "/etc/machine-id:/etc/machine-id:ro"]
    restart: unless-stopped
    mem_limit: 256m
    pids_limit: 256
{{- if not .DataDir}}
volumes:
  meshctl-data: {}
{{- end}}
